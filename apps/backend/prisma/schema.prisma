generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Group {
  id        String    @id @default(uuid())
  name      String
  clients   Client[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
}

model Client {
  id        String    @id @default(uuid())
  name      String
  groupId   String
  group     Group     @relation(fields: [groupId], references: [id])
  orders    Order[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
}

model Ingredient {
  id            String             @id @default(uuid())
  name          String
  unit          String
  recipes       RecipeIngredient[]
  purchaseItems PurchaseItem[]
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  deletedAt     DateTime?
}

model Recipe {
  id         String            @id @default(uuid())
  name       String
  active     Boolean           @default(true)
  priceTypes RecipePriceType[]
  menuItems  MenuItem[]
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  deletedAt  DateTime?
}

model RecipeIngredient {
  id                 String          @id @default(uuid())
  recipePriceTypeId  String
  ingredientId       String
  quantity           Float
  recipePriceType    RecipePriceType @relation(fields: [recipePriceTypeId], references: [id], onDelete: Cascade)
  ingredient         Ingredient      @relation(fields: [ingredientId], references: [id])

  @@unique([recipePriceTypeId, ingredientId])
}

model RecipePriceType {
  id          String             @id @default(uuid())
  recipeId    String
  priceTypeId String
  recipe      Recipe             @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  priceType   PriceType          @relation(fields: [priceTypeId], references: [id])
  ingredients RecipeIngredient[]

  @@unique([recipeId, priceTypeId])
}

model PriceType {
  id             String              @id @default(uuid())
  type           String
  size           String
  pixPrice       Int
  swilePrice     Int
  additionalCost Int                 @default(0)
  orderItems     OrderItem[]
  recipes        RecipePriceType[]
  menuItems      MenuItemPriceType[]
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  deletedAt      DateTime?

}

model Week {
  id           String        @id @default(uuid())
  weekNumber   Int
  year         Int
  menuItems    MenuItem[]
  orders       Order[]
  purchase     Purchase?
  generalCosts GeneralCost[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  deletedAt    DateTime?

  @@unique([weekNumber, year])
}

model MenuItem {
  id         String              @id @default(uuid())
  weekId     String
  recipeId   String
  week       Week                @relation(fields: [weekId], references: [id])
  recipe     Recipe              @relation(fields: [recipeId], references: [id])
  priceTypes MenuItemPriceType[]
  orderItems OrderItem[]
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt
  deletedAt  DateTime?

}

model MenuItemPriceType {
  id          String    @id @default(uuid())
  menuItemId  String
  priceTypeId String
  menuItem    MenuItem  @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  priceType   PriceType @relation(fields: [priceTypeId], references: [id])

  @@unique([menuItemId, priceTypeId])
}

model Order {
  id            String      @id @default(uuid())
  weekId        String
  clientId      String
  status        String      @default("pending")
  paymentMethod String?
  week          Week        @relation(fields: [weekId], references: [id])
  client        Client      @relation(fields: [clientId], references: [id])
  items         OrderItem[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  deletedAt     DateTime?
}

model OrderItem {
  id                 String    @id @default(uuid())
  orderId            String
  menuItemId         String
  priceTypeId        String
  quantity           Int       @default(1)
  snapshotPixPrice   Int
  snapshotSwilePrice Int
  order              Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItem           MenuItem  @relation(fields: [menuItemId], references: [id])
  priceType          PriceType @relation(fields: [priceTypeId], references: [id])
  deletedAt          DateTime?
}

model Purchase {
  id        String         @id @default(uuid())
  weekId    String         @unique
  week      Week           @relation(fields: [weekId], references: [id])
  items     PurchaseItem[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  deletedAt DateTime?
}

model PurchaseItem {
  id           String     @id @default(uuid())
  purchaseId   String
  ingredientId String
  quantity     Float
  totalValue   Int
  unitValue    Int
  location     String?
  purchase     Purchase   @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id])
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  deletedAt    DateTime?
}

model GeneralCost {
  id          String    @id @default(uuid())
  weekId      String
  description String
  value       Int
  type        String    @default("fixo")
  week        Week      @relation(fields: [weekId], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
}

model Config {
  id            String @id @default(uuid())
  gasPercentage Float
}

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Group {
  id        String    @id @default(cuid())
  name      String    @unique
  clients   Client[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
}

model Client {
  id        String    @id @default(cuid())
  name      String
  groupId   String
  group     Group     @relation(fields: [groupId], references: [id])
  orders    Order[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
}

model Ingredient {
  id            String             @id @default(cuid())
  name          String             @unique
  unit          String
  recipes       RecipeIngredient[]
  purchaseItems PurchaseItem[]
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  deletedAt     DateTime?
}

model Recipe {
  id          String             @id @default(cuid())
  name        String             @unique
  ingredients RecipeIngredient[]
  menuItems   MenuItem[]
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  deletedAt   DateTime?
}

model RecipeIngredient {
  id           String     @id @default(cuid())
  recipeId     String
  ingredientId String
  quantity     Float
  recipe       Recipe     @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id])

  @@unique([recipeId, ingredientId])
}

model PriceType {
  id         String      @id @default(cuid())
  type       String
  size       String
  pixPrice   Float
  swilePrice Float
  orderItems OrderItem[]
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  deletedAt  DateTime?

  @@unique([type, size])
}

model Week {
  id           String        @id @default(cuid())
  weekNumber   Int
  year         Int
  menuItems    MenuItem[]
  orders       Order[]
  purchase     Purchase?
  generalCosts GeneralCost[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  deletedAt    DateTime?

  @@unique([weekNumber, year])
}

model MenuItem {
  id         String      @id @default(cuid())
  weekId     String
  recipeId   String
  week       Week        @relation(fields: [weekId], references: [id])
  recipe     Recipe      @relation(fields: [recipeId], references: [id])
  orderItems OrderItem[]
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  deletedAt  DateTime?

  @@unique([weekId, recipeId])
}

model Order {
  id            String      @id @default(cuid())
  weekId        String
  clientId      String
  status        String      @default("pendente")
  paymentMethod String?
  week          Week        @relation(fields: [weekId], references: [id])
  client        Client      @relation(fields: [clientId], references: [id])
  items         OrderItem[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  deletedAt     DateTime?
}

model OrderItem {
  id                 String    @id @default(cuid())
  orderId            String
  menuItemId         String
  priceTypeId        String
  quantity           Int       @default(1)
  snapshotPixPrice   Float
  snapshotSwilePrice Float
  order              Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItem           MenuItem  @relation(fields: [menuItemId], references: [id])
  priceType          PriceType @relation(fields: [priceTypeId], references: [id])
  deletedAt          DateTime?
}

model Purchase {
  id        String         @id @default(cuid())
  weekId    String         @unique
  week      Week           @relation(fields: [weekId], references: [id])
  items     PurchaseItem[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  deletedAt DateTime?
}

model PurchaseItem {
  id           String     @id @default(cuid())
  purchaseId   String
  ingredientId String
  quantity     Float
  totalPrice   Float
  unitPrice    Float
  location     String?
  purchase     Purchase   @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id])
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  deletedAt    DateTime?
}

model GeneralCost {
  id          String    @id @default(cuid())
  weekId      String
  description String
  value       Float
  type        String    @default("fixo")
  week        Week      @relation(fields: [weekId], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
}

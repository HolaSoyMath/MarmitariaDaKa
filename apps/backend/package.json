{
  "name": "@marmitaria/backend",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "bun run --hot src/index.ts",
    "typecheck": "tsc",
    "build": "bun run typecheck && bun build src/index.ts --target bun --outdir dist",
    "start": "bunx prisma migrate deploy && bun run dist/index.js",
    "seed": "bun run prisma/seed.ts"
  },
  "prisma": {
    "seed": "bun run prisma/seed.ts"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.4.2",
    "@elysiajs/eden": "^1.2.0",
    "@marmitaria/schemas": "*",
    "@prisma/adapter-pg": "7.2.0",
    "elysia": "^1.2.0",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/pg": "^8.20.0",
    "dotenv": "^17.4.2"
  }
}
